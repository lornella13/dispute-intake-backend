#   python3 -c "import hashlib,os,base64; s=base64.b64encode(os.urandom(16)).decode(); h=hashlib.pbkdf2_hmac('sha256', b'password', base64.b64decode(s), 100000); print(base64.b64encode(h).decode()+'$'+s)"
